<?xml version="1.0"?>
<!--
  Dron F450 — descripción completa.

      xacro dron_f450.urdf.xacro                        # mallas + Gazebo
      xacro dron_f450.urdf.xacro mallas:=false          # primitivas (rápido)
      xacro dron_f450.urdf.xacro simulacion:=false      # sin plugins, solo RViz

  El chasis sale de la malla F450.dae (cortesía del compañero de equipo): un F450
  real medido en 451 mm de diagonal motor a motor.
-->
<robot name="dron_f450" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="mallas" default="true"/>
  <xacro:arg name="simulacion" default="true"/>

  <xacro:include filename="$(find dron_description)/urdf/parametros.xacro"/>
  <xacro:include filename="$(find dron_description)/urdf/chasis.xacro"/>
  <xacro:include filename="$(find dron_description)/urdf/sensores.xacro"/>
  <xacro:include filename="$(find dron_description)/urdf/gazebo.xacro"/>

  <xacro:chasis mallas="$(arg mallas)"/>
  <xacro:sensores simulacion="$(arg simulacion)"/>

  <xacro:if value="$(arg simulacion)">
    <xacro:gazebo_dron/>
  </xacro:if>

</robot>
