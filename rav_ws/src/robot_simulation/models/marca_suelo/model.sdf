<?xml version="1.0"?>
<sdf version="1.6">
  <model name="marca_suelo">
    <static>true</static>
    <link name="marca">
      <!-- Cuatro listones finos formando un cuadrado de 1 m de lado, sin
           colisión: son solo referencia visual, no deben tocar al dron. -->
      <visual name="borde_norte">
        <pose>0.5 0 0.001 0 0 0</pose>
        <geometry><box><size>0.02 1.0 0.002</size></box></geometry>
        <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
      </visual>
      <visual name="borde_sur">
        <pose>-0.5 0 0.001 0 0 0</pose>
        <geometry><box><size>0.02 1.0 0.002</size></box></geometry>
        <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
      </visual>
      <visual name="borde_este">
        <pose>0 -0.5 0.001 0 0 0</pose>
        <geometry><box><size>1.0 0.02 0.002</size></box></geometry>
        <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
      </visual>
      <visual name="borde_oeste">
        <pose>0 0.5 0.001 0 0 0</pose>
        <geometry><box><size>1.0 0.02 0.002</size></box></geometry>
        <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
      </visual>
      <visual name="centro">
        <pose>0 0 0.001 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
